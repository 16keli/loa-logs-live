    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.15",
    "tslib": "^2.4.1",
    "typescript": "5.9.3",
    "vite": "^7.1.11"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.0.1",
